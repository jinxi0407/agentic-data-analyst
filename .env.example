# =========================
# Qwen / DashScope
# =========================
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_CHAT_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_DIMENSION=1024

# =========================
# MySQL
# =========================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=agentic_data_analyst
MYSQL_USER=agentic_user
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# =========================
# Agent Runtime
# =========================
MAX_RETRY=2
MAX_STEPS=15
SQL_MAX_ROWS=200
SCHEMA_TOP_K=12
SCHEMA_SIMILARITY_THRESHOLD=0.15
AGENT_TIMEOUT_SECONDS=60

# =========================
# API
# =========================
API_HOST=127.0.0.1
API_PORT=8002
UI_PORT=8502
